ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=super-secret-key-change-me

# Banco dos leads. Com DATABASE_URL definida, os leads vao para o Postgres;
# sem ela, continuam no arquivo leads.json dentro de DATA_DIR.
# A tabela e criada sozinha na primeira subida.
# Para levar os leads que ja existem no arquivo: npm run import-leads
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# (use ...?sslmode=disable num Postgres local sem TLS)

# Onde ficam courses.json e, quando nao ha DATABASE_URL, leads.json.
# EM PRODUCAO aponte para um volume persistente: sem isso, cada deploy
# reinicia o container e apaga os leads capturados.
# DATA_DIR=/data

# Imagem padrao do preview do link (WhatsApp/Instagram). Use 1200x630.
# DEFAULT_OG_IMAGE=https://www.virgulacontabil.com.br/capa-cursos.png
